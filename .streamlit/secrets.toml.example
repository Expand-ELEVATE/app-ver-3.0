# Copy the values below into Streamlit Community Cloud -> your app ->
# Settings -> Secrets (Advanced settings). NEVER commit a real
# secrets.toml to this repo.
#
# This is a MERGED v3 app: one deployment serves both the shared State
# login and all National admin logins. It therefore needs BOTH keys —
# SUPABASE_SERVICE_ROLE_KEY bypasses Row-Level Security entirely and is
# used ONLY inside pages gated by require_role(["national"]) (Admin API
# login management, full-platform backup+wipe). Every privileged code
# path must check the role explicitly — see common.py's module
# docstring for why there is no longer a separate deployment to fall
# back on as a physical boundary.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"
